<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="OpenMcdf" />
      <package pattern="Microsoft.Windows.SDK.NET.Ref" />
      <!-- net10.0 targeting packs: an SDK newer than 10 does not carry them and restores them instead. -->
      <package pattern="Microsoft.NETCore.App.Ref" />
      <package pattern="Microsoft.WindowsDesktop.App.Ref" />
      <package pattern="Microsoft.AspNetCore.App.Ref" />
      <package pattern="Microsoft.NETCore.App.Host.win-x64" />
    </packageSource>
  </packageSourceMapping>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
