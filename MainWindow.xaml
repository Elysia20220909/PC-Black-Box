<Window x:Class="DestinyBlackBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Black Box"
        Width="980" Height="690"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="assets/pc-black-box.ico"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource WindowBrush}" BorderBrush="#3C444F" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#13171C" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                    <Border Width="22" Height="22" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,10,0">
                        <Grid>
                            <Rectangle Width="10" Height="10" Stroke="#111318" StrokeThickness="2" />
                            <Ellipse Width="3" Height="3" Fill="#111318" />
                        </Grid>
                    </Border>
                    <TextBlock Text="PC BLACK BOX" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text=" / DOWNLOAD INSPECTOR" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="7,2,0,0" VerticalAlignment="Center" />
                    <Border Background="#193BD39C" BorderBrush="#493BD39C" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="13,0,0,0">
                        <TextBlock x:Name="ReadOnlyBadgeText" Text="READ ONLY" Foreground="{StaticResource GoodBrush}" FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource NavButton}" Width="44" Click="Minimize_Click" />
                    <Button Content="×" Style="{StaticResource NavButton}" Width="44" FontSize="17" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="#15191F">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="11,0,0,0">
                    <Button x:Name="OverviewNav" Content="OVERVIEW" Style="{StaticResource NavButton}" Tag="active" Click="OverviewNav_Click" />
                    <Button x:Name="FilesNav" Content="FILES" Style="{StaticResource NavButton}" Click="FilesNav_Click" />
                    <Button x:Name="ReportNav" Content="REPORT" Style="{StaticResource NavButton}" Click="ReportNav_Click" />
                </StackPanel>
                <Button x:Name="LanguageButton" Grid.Column="1" Content="JA / EN" Style="{StaticResource NavButton}" Margin="0,0,8,0" Click="Language_Click" />
            </Grid>

            <Grid Grid.Row="2" Margin="18">
                <Grid x:Name="OverviewPage">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,13,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="DropZone" Grid.Row="0" Background="#151A20" BorderBrush="#4B5562" BorderThickness="1" CornerRadius="3" Padding="18" MinHeight="128">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TargetHeaderText" Text="調査対象をドロップ" FontSize="18" FontWeight="Light" />
                                <TextBlock x:Name="TargetPathText" Grid.Row="1" Text="ファイルまたはフォルダーを選択してください" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                                    <Button x:Name="SelectFileButton" Content="ファイルを選ぶ" Style="{StaticResource GhostButton}" Click="SelectFile_Click" />
                                    <Button x:Name="SelectFolderButton" Content="フォルダーを選ぶ" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SelectFolder_Click" />
                                    <Button x:Name="InspectButton" Content="調査開始" Style="{StaticResource ActionButton}" Margin="8,0,0,0" IsEnabled="False" Click="Inspect_Click" />
                                    <Button x:Name="CancelButton" Content="停止" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricBorder}">
                                <StackPanel><TextBlock x:Name="RiskLabel" Text="RISK" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="RiskValue" Text="—" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricBorder}">
                                <StackPanel><TextBlock x:Name="FilesLabel" Text="FILES" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="FilesValue" Text="—" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricBorder}">
                                <StackPanel><TextBlock x:Name="ActiveLabel" Text="ACTIVE" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ActiveValue" Text="—" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricBorder}">
                                <StackPanel><TextBlock x:Name="SignedLabel" Text="SIGNED" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="SignedValue" Text="—" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource MetricBorder}" Margin="0">
                                <StackPanel><TextBlock x:Name="TimeLabel" Text="TIME" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="TimeValue" Text="—" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ProgressBar x:Name="ScanProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" Background="#26303A" BorderThickness="0" />
                            <TextBlock x:Name="ProgressText" Grid.Row="1" Text="待機中 — 対象は実行しません" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="ScopeTitleText" Text="調査するもの" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock x:Name="ScopeBodyText" Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="19" Margin="0,10,0,0"
                                           Text="SHA-256 / Authenticode署名 / Internet Zone / 入手元ホスト / 実ファイル形式 / 拡張子偽装 / エントロピー / スクリプト能力 / ZIP内部構造&#x0a;&#x0a;実行・アップロード・パケット取得・ゲームメモリ読取は行いません。" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock x:Name="FindingsTitleText" Text="主な所見" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="AssessmentText" Text="NO TARGET" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Grid.Row="1" Background="#12FFFFFF" BorderBrush="#26303A" BorderThickness="1" Padding="11" Margin="0,12,0,12">
                                <TextBlock x:Name="VerdictText" Text="対象を選択すると、根拠とともに評価します。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" />
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FindingsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="FilesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="FileSearchBox" Style="{StaticResource FilterTextBox}" TextChanged="FileSearchBox_TextChanged"
                                         AutomationProperties.Name="File search" ToolTip="Search file name, type, signature, signer, or finding" />
                                <TextBlock x:Name="FileSearchHintText" Text="ファイル名・種類・署名を検索" Foreground="#69727E" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button x:Name="AllFilterButton" Content="すべて" CommandParameter="ALL" Tag="active" Style="{StaticResource FilterButton}" Click="FileFilter_Click" />
                                <Button x:Name="HighFilterButton" Content="高" CommandParameter="HIGH" Style="{StaticResource FilterButton}" Margin="5,0,0,0" Click="FileFilter_Click" />
                                <Button x:Name="ReviewFilterButton" Content="確認" CommandParameter="REVIEW" Style="{StaticResource FilterButton}" Margin="5,0,0,0" Click="FileFilter_Click" />
                                <Button x:Name="LowFilterButton" Content="低" CommandParameter="LOW" Style="{StaticResource FilterButton}" Margin="5,0,0,0" Click="FileFilter_Click" />
                                <Button x:Name="ClearFilterButton" Content="所見なし" CommandParameter="CLEAR" Style="{StaticResource FilterButton}" Margin="5,0,0,0" Click="FileFilter_Click" />
                            </StackPanel>
                            <Button x:Name="ClearSearchButton" Grid.Column="2" Content="×" Width="31" Height="31" HorizontalAlignment="Left" Margin="8,0,0,0"
                                    Style="{StaticResource GhostButton}" Padding="0" ToolTip="Clear search" Click="ClearSearch_Click" />
                            <TextBlock x:Name="FileFilterCountText" Grid.Column="3" Text="0 / 0" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,2,0" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="FileGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#293039"
                              RowBackground="#171B21" AlternatingRowBackground="#1B2027" SelectionMode="Single"
                              FontSize="11" SelectionChanged="FileGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#20262E"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="10"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4A3D00"/><Setter Property="Foreground" Value="White"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RISK" Binding="{Binding RiskDisplay}" Width="78" />
                            <DataGridTextColumn Header="FILE" Binding="{Binding RelativePath}" Width="*" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding FileType}" Width="130" />
                            <DataGridTextColumn Header="SIGNATURE" Binding="{Binding SignatureStatus}" Width="105" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Short}" Width="145" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="FileDetailText" Text="ファイルを選択すると詳細を表示します。" FontFamily="Consolas" FontSize="10.5" Foreground="#D8DCE1" TextWrapping="Wrap" LineHeight="17" />
                            </ScrollViewer>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Button x:Name="CopyHashButton" Content="SHA-256をコピー" Style="{StaticResource GhostButton}" IsEnabled="False" Click="CopyHash_Click" />
                                <Button x:Name="CopyLookupUrlButton" Content="照会URLをコピー" Style="{StaticResource GhostButton}" IsEnabled="False" Click="CopyLookupUrl_Click" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ReportPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="ReportTitleText" Text="匿名化された調査レポート" FontSize="15" FontWeight="Light" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CopyReportButton" Content="コピー" Style="{StaticResource GhostButton}" IsEnabled="False" Click="CopyReport_Click" />
                            <Button x:Name="SaveMarkdownButton" Content="Markdown保存" Style="{StaticResource ActionButton}" IsEnabled="False" Margin="8,0,0,0" Click="SaveMarkdown_Click" />
                            <Button x:Name="SaveJsonButton" Content="JSON保存" Style="{StaticResource GhostButton}" IsEnabled="False" Margin="8,0,0,0" Click="SaveJson_Click" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="ReportPreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}"
                             Foreground="#DDE1E6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" FontFamily="Consolas" FontSize="10.5"
                             Text="調査完了後にレポートが表示されます。" />
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Background="#13171C">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PrivacyFooterText" Text="LOCAL ONLY • NO EXECUTION • NO UPLOAD" Foreground="#6F7985" FontSize="9" VerticalAlignment="Center" Margin="17,0,0,0" />
                <TextBlock x:Name="ShortcutFooterText" Grid.Column="1" Text="CTRL+O FILE • CTRL+F FIND • F5 INSPECT" Foreground="#606A76" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" Grid.Column="2" Text="v0.1 • STATIC OBSERVATION" Foreground="#6F7985" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,17,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
