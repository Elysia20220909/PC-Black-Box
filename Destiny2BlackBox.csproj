<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DestinyBlackBox</RootNamespace>
    <AssemblyName>PC Black Box</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\pc-black-box.ico</ApplicationIcon>
    <Version>0.11.0</Version>
    <FileVersion>0.11.0.0</FileVersion>
    <AssemblyVersion>0.11.0.0</AssemblyVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Runtime surface removed from the shipped process. -->
  <PropertyGroup>
    <!-- No in-process IL patching path (hot reload / metadata update). -->
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- No EventSource tracing surface for out-of-process listeners. -->
    <EventSourceSupport>false</EventSourceSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Supply chain: any advisory on any dependency, direct or transitive, fails the build. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\pc-black-box.ico" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
