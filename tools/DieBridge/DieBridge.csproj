<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>../../assets/pc-black-box.ico</ApplicationIcon>
    <ApplicationManifest>../../app.manifest</ApplicationManifest>
    <Version>0.13.0</Version>
    <Description>PC Black Box integrated DiE launcher</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../SecurityPolicy.cs" Link="SecurityPolicy.cs" />
    <Compile Include="../../SecureFileReader.cs" Link="SecureFileReader.cs" />
    <Compile Include="../../ProcessObjectLockdown.cs" Link="ProcessObjectLockdown.cs" />
    <Compile Include="../../SecurityControlState.cs" Link="SecurityControlState.cs" />
    <Compile Include="../../DiePipeProtocol.cs" Link="DiePipeProtocol.cs" />
  </ItemGroup>
</Project>
